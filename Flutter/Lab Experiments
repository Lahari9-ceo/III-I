              style: TextStyle(fontSize: 20),
            ),
            Text(
              '$count',
              style: const TextStyle(fontSize: 40),
            ),
            ElevatedButton(
              onPressed: incrementCounter,
              child: const Text('Increment'),
            ),
          ],
        ),
      ),
    );
  }
}

